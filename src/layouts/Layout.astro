---
interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const { title, description, ogType = "website" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <style>
      @font-face {
        font-family: "Hack";
        src: url("/fonts/Hack-Regular.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Hack";
        src: url("/fonts/Hack-Bold.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Hack";
        src: url("/fonts/Hack-Italic.woff2") format("woff2");
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: "Hack";
        src: url("/fonts/Hack-BoldItalic.woff2") format("woff2");
        font-weight: 700;
        font-style: italic;
        font-display: swap;
      }

      *, *::before, *::after { box-sizing: border-box; }

      :root {
        /* palette */
        --palette-white: #ffffff;
        --palette-linen: #E8E8E8;
        --palette-mist: #BAC8B1;
        --palette-sage: #94AE87;
        --palette-slate: #8FA9A5;
        --palette-slate-bright: #A3C0BC;
        --palette-forest: #3A4A35;
        --palette-forest-light: #5A7350;
        --palette-forest-mid: #4E5F47;
        --palette-forest-dark: #252E21;
        --palette-pink: #c290b8;

        /* semantic */
        --color-bg: var(--palette-forest-dark);
        --color-surface: var(--palette-forest);
        --color-surface-hover: var(--palette-forest-light);
        --color-border: var(--palette-forest-mid);

        --color-heading: var(--palette-white);
        --color-heading-sub: var(--palette-mist);
        --color-text: var(--palette-linen);
        --color-text-muted: var(--palette-mist);
        --color-text-subtle: var(--palette-sage);

        --color-accent: var(--palette-slate-bright);
        --color-accent-subtle: var(--palette-slate);

        /* typography */
        --font-body: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --font-mono: "Hack", ui-monospace, Menlo, Consolas, monospace;
        --font-size-body: 1rem;

        /* layout */
        --content-width: 52rem;
        --content-width-narrow: 680px;
      }

      body {
        font-family: var(--font-body);
        font-size: var(--font-size-body);
        background: var(--color-bg);
        color: var(--color-text);
        margin: 0;
        padding: 2rem 1.5rem;
        line-height: 1.6;
        position: relative;
        isolation: isolate;
      }

      body::before {
        content: "";
        position: fixed;
        inset: 0;
        z-index: -1;
        background: url("/green-forest.jpg") center / cover no-repeat;
        filter: blur(8px) brightness(0.4);
        transform: scale(1.05);
      }

      main {
        max-width: var(--content-width);
        margin: 0 auto;
      }

      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 3rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-border);
      }

      .nav-brand {
        font-family: var(--font-mono);
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-heading) !important;
        text-decoration: none !important;
        letter-spacing: -0.02em;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 2rem;
      }

      .nav-links a {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--color-text-muted);
        text-decoration: none;
        padding: 0.25rem 0;
        border-bottom: 2px solid transparent;
        transition: color 0.15s ease, border-color 0.15s ease;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }

      .nav-links a:hover {
        color: var(--color-accent);
      }

      .nav-links a.active {
        color: var(--color-accent);
        font-weight: 700;
        border-bottom-color: var(--color-accent);
      }

      :global(a) {
        color: var(--color-text-muted);
        text-decoration: none;
        transition: color 0.15s ease;
      }

      :global(a:hover) {
        color: var(--color-accent-subtle);
      }

      @media (max-width: 600px) {
        body {
          padding: 1.25rem 1rem;
        }

        nav {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.75rem;
        }

        .nav-links {
          gap: 1.25rem;
        }

        .nav-links a {
          font-size: 0.8rem;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <nav>
        <a href="/" class="nav-brand">terminus</a>
        <div class="nav-links">
          <a href="/" class:list={[{ active: currentPath === "/" }]}>Home</a>
          <a href="/writing" class:list={[{ active: currentPath.startsWith("/writing") }]}>Writing</a>
          <a href="/experience" class:list={[{ active: currentPath.startsWith("/experience") }]}>Experience</a>
        </div>
      </nav>
      <slot />
    </main>
  </body>
</html>
