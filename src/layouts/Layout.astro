---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      @font-face {
        font-family: "Hack";
        src: url("/fonts/Hack-Regular.woff2") format("woff2");
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Hack";
        src: url("/fonts/Hack-Bold.woff2") format("woff2");
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Hack";
        src: url("/fonts/Hack-Italic.woff2") format("woff2");
        font-weight: 400;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: "Hack";
        src: url("/fonts/Hack-BoldItalic.woff2") format("woff2");
        font-weight: 700;
        font-style: italic;
        font-display: swap;
      }

      *, *::before, *::after { box-sizing: border-box; }

      :root {
        /* palette — swap these to change the color scheme */
        --palette-white: #ffffff;
        --palette-linen: #E6E6E6;
        --palette-mist: #BAC8B1;
        --palette-sage: #7B9669;
        --palette-slate: #6C8480;
        --palette-forest: #404E3B;
        --palette-forest-mid: #526648;
        --palette-forest-dark: #2D3829;

        /* semantic — what each role means */
        --color-bg: var(--palette-forest);
        --color-surface: var(--palette-forest-dark);  /* code blocks, inset areas */
        --color-border: var(--palette-forest-mid);    /* dividers, borders */

        --color-heading: var(--palette-white);        /* h1 */
        --color-heading-sub: var(--palette-mist);     /* h2, subheadings */
        --color-text: var(--palette-linen);           /* body text */
        --color-text-muted: var(--palette-mist);      /* dates, secondary labels */
        --color-text-subtle: var(--palette-sage);     /* tertiary labels, counters */

        --color-accent: var(--palette-slate);         /* links */

        --font-body: Georgia, "Times New Roman", serif;
        --font-mono: "Hack", ui-monospace, Menlo, Consolas, monospace;
        --font-size-body: 1rem;
      }

      body {
        font-family: var(--font-body);
        font-size: var(--font-size-body);
        background: var(--color-bg);
        color: var(--color-text);
        margin: 0;
        padding: 2rem 1rem;
        line-height: 1.6;
      }

      main {
        max-width: 680px;
        margin: 0 auto;
      }

      nav {
        margin-bottom: 3rem;
      }

      nav a {
        color: var(--color-accent);
        text-decoration: none;
        margin-right: 1.5rem;
        font-family: var(--font-mono);
        font-size: 0.9rem;
      }

      nav a:hover {
        text-decoration: underline;
      }

      :global(a) {
        color: var(--color-text-muted);
        text-decoration: none;
      }

      :global(a:hover) {
        color: var(--color-accent);
      }
    </style>
  </head>
  <body>
    <main>
      <nav>
        <a href="/">~</a>
        <a href="/experience">experience</a>
        <a href="/writing">writing</a>
      </nav>
      <slot />
    </main>
  </body>
</html>
