---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  date: Date;
  description?: string;
}

const { title, date, description } = Astro.props;

const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={title}>
  <article>
    <header>
      <h1>{title}</h1>
      <time datetime={date.toISOString()}>{formatted}</time>
      {description && <p class="description">{description}</p>}
    </header>
    <slot />
  </article>
</Layout>

<style>
  h1 {
    margin: 0 0 0.25rem;
    font-size: 1.75rem;
    color: #ffffff;
  }

  time {
    font-family: monospace;
    font-size: 0.85rem;
    color: #888;
  }

  .description {
    margin-top: 0.75rem;
    color: #aaa;
    font-style: italic;
  }

  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #2a2a2a;
  }

  article :global(h2) {
    color: #e0ddd5;
    margin-top: 2rem;
  }

  article :global(p) {
    margin: 1rem 0;
  }

  article :global(code) {
    font-family: monospace;
    background: #1e1e1e;
    padding: 0.1em 0.3em;
    border-radius: 3px;
    font-size: 0.9em;
  }

  article :global(pre) {
    background: #1e1e1e;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
  }

  article :global(img.typst-frame) {
    vertical-align: middle;
  }
</style>
