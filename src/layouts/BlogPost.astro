---
import Layout from "./Layout.astro";
import { toSlug, formatDate } from "../utils/format";

interface Props {
  title: string;
  date: Date;
  description?: string;
  post?: any;
}

const { title, date, description, post } = Astro.props;

const seriesName = post?.data?.series?.name;
const currentPart = post?.data?.series?.part;
const seriesSlug = seriesName ? toSlug(seriesName) : null;

const formatted = formatDate(date, "long");
---

<Layout title={title}>
  <article>
    <header>
      <div class="title-row">
        <h1>{title}</h1>
        <time datetime={date.toISOString()}>{formatted}</time>
      </div>
      {seriesName && (
        <p class="series-link">
          <a href={`/series/${seriesSlug}`}>{seriesName}</a>
          <span class="series-part">part {currentPart}</span>
        </p>
      )}
      {description && <p class="description">{description}</p>}
    </header>
    <slot />
  </article>
</Layout>

<style>
  .title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  h1 {
    margin: 0;
    font-size: 1.75rem;
    color: var(--color-heading);
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .description {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  article :global(h2) {
    color: var(--color-heading-sub);
    margin-top: 2rem;
  }

  article :global(p) {
    margin: 1rem 0;
  }

  article :global(code) {
    font-family: var(--font-mono);
    background: var(--color-surface);
    padding: 0.1em 0.3em;
    border-radius: 3px;
    font-size: 0.875em;
  }

  article :global(pre) {
    background: var(--color-surface);
    font-size: 0.875em;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
  }

  article :global(pre code) {
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }

  article :global(.code-with-filename) {
    border-radius: 4px;
    overflow: hidden;
  }

  article :global(.code-filename) {
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75em;
    padding: 0.35em 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  article :global(.code-with-filename pre) {
    border-radius: 0;
    margin: 0;
  }

  article :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  article :global(figure.typst-figure) {
    margin: 1.5rem 0;
    text-align: center;
  }

  article :global(figure.typst-figure figcaption) {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  article :global(span.typst-math-inline) {
    display: inline-block;
    vertical-align: middle;
    line-height: 1;
  }

  article :global(span.typst-math-inline svg) {
    height: var(--font-size-body);
    width: auto;
    overflow: visible;
  }

  article :global(span.typst-math-block) {
    display: block;
    text-align: center;
    margin: 1.5rem 0;
  }

  article :global(figure.typst-figure table) {
    margin: 0;
  }

  article :global(table) {
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
    max-width: 100%;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  article :global(th) {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--color-border);
    color: var(--color-heading-sub);
  }

  article :global(td) {
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  article :global(tr:last-child td) {
    border-bottom: none;
  }

  .series-link {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .series-link a {
    color: var(--color-accent-subtle);
    text-decoration: none;
  }

  .series-link a:hover {
    text-decoration: underline;
  }

  .series-part {
    color: var(--color-text-subtle);
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 1.35rem;
    }

    .title-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>

<script>
  // Typst's HTML export puts html.frame() content in its own <p> even for
  // inline math. Merge those isolated math paragraphs back into surrounding text.
  document.querySelectorAll('article span.typst-math-inline').forEach(mathSpan => {
    const mathP = mathSpan.parentElement;
    if (!mathP || mathP.tagName !== 'P') return;

    const isIsolated = [...mathP.childNodes].every(
      node => node === mathSpan || (node.nodeType === 3 && node.textContent.trim() === '')
    );
    if (!isIsolated) return;

    const prevP = mathP.previousElementSibling;
    if (prevP?.tagName !== 'P') return;

    const nextP = mathP.nextElementSibling;
    prevP.appendChild(mathSpan);
    mathP.remove();

    if (nextP?.tagName === 'P') {
      while (nextP.firstChild) prevP.appendChild(nextP.firstChild);
      nextP.remove();
    }
  });

  // Convert img.typst-frame inside inline math to inline SVG so
  // overflow: visible works and tall glyphs (∫, ∑, …) aren't clipped.
  document.querySelectorAll('article span.typst-math-inline img.typst-frame').forEach(img => {
    const src = img.getAttribute('src') ?? '';
    if (!src.startsWith('data:image/svg+xml;base64,')) return;

    const svgText = atob(src.slice('data:image/svg+xml;base64,'.length));
    const doc = new DOMParser().parseFromString(svgText, 'image/svg+xml');
    const svg = doc.documentElement;

    img.replaceWith(svg);
  });
</script>
