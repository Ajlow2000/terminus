---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  date: Date;
  description?: string;
}

const { title, date, description } = Astro.props;

const formatted = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={title}>
  <article>
    <header>
      <h1>{title}</h1>
      <time datetime={date.toISOString()}>{formatted}</time>
      {description && <p class="description">{description}</p>}
    </header>
    <slot />
  </article>
</Layout>

<style>
  h1 {
    margin: 0 0 0.25rem;
    font-size: 1.75rem;
    color: #ffffff;
  }

  time {
    font-family: monospace;
    font-size: 0.85rem;
    color: #888;
  }

  .description {
    margin-top: 0.75rem;
    color: #aaa;
    font-style: italic;
  }

  header {
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #2a2a2a;
  }

  article :global(h2) {
    color: #e0ddd5;
    margin-top: 2rem;
  }

  article :global(p) {
    margin: 1rem 0;
  }

  article :global(code) {
    font-family: monospace;
    background: #1e1e1e;
    padding: 0.1em 0.3em;
    border-radius: 3px;
    font-size: 0.9em;
  }

  article :global(pre) {
    background: #1e1e1e;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
  }

  article :global(pre code) {
    background: transparent;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }

  article :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  article :global(figure.typst-figure) {
    margin: 1.5rem 0;
    text-align: center;
  }

  article :global(figure.typst-figure figcaption) {
    font-size: 0.85rem;
    color: #888;
    margin-top: 0.5rem;
  }

  article :global(span.typst-math) {
    display: block;
    text-align: center;
    margin: 1.5rem 0;
  }

  article :global(figure.typst-figure table) {
    margin: 0;
  }

  article :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  article :global(th) {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid #3a3a3a;
    color: #e0ddd5;
  }

  article :global(td) {
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid #2a2a2a;
  }

  article :global(tr:last-child td) {
    border-bottom: none;
  }
</style>
