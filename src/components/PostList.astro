---
import { formatDate } from "../utils/format";

interface Post {
  id: string;
  data: {
    title: string;
    date: Date;
  };
}

interface Props {
  posts: Post[];
  numbered?: boolean;
}

const { posts, numbered = false } = Astro.props;
const Tag = numbered ? "ol" : "ul";
---

<Tag>
  {posts.map((post) => (
    <li>
      <a href={`/writing/${post.id.replace(/\.[^.]+$/, "")}`}>{post.data.title}</a>
      <time>{formatDate(post.data.date)}</time>
    </li>
  ))}
</Tag>

<style>
  ul, ol {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: post-counter;
  }

  li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
    gap: 0.25rem;
    counter-increment: post-counter;
  }

  ol li::before {
    content: counter(post-counter) ".";
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-subtle);
    min-width: 1.25rem;
  }

  a {
    color: var(--color-text);
    text-decoration: none;
    flex: 1;
  }

  a:hover {
    color: var(--color-heading);
    text-decoration: underline;
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-subtle);
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    li {
      flex-wrap: wrap;
      row-gap: 0.15rem;
    }

    time {
      flex-basis: 100%;
    }
  }
</style>
