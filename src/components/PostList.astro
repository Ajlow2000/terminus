---
import { formatDate } from "../utils/format";

interface Post {
  id: string;
  data: {
    title: string;
    date: Date;
  };
}

interface Props {
  posts: Post[];
  numbered?: boolean;
}

const { posts, numbered = false } = Astro.props;
const Tag = numbered ? "ol" : "ul";
---

<Tag>
  {posts.map((post) => (
    <li>
      <a href={`/writing/${post.id.replace(/\.[^.]+$/, "")}`}>{post.data.title}</a>
      <time>{formatDate(post.data.date)}</time>
    </li>
  ))}
</Tag>

<style>
  ul, ol {
    list-style: none; padding: 0; margin: 0;
    counter-reset: post-counter;
  }
  li {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line-2);
    gap: 1rem; counter-increment: post-counter;
  }
  ol li::before {
    content: counter(post-counter) ".";
    font-family: var(--f-mono); font-size: 12px;
    color: var(--ink-3); min-width: 1.25rem;
  }
  a {
    color: var(--ink); text-decoration: none; flex: 1;
    transition: color 0.15s;
  }
  a:hover { color: var(--forest); text-decoration: underline; }
  time {
    font-family: var(--f-mono); font-size: 12px;
    color: var(--ink-3); white-space: nowrap;
  }
  @media (max-width: 600px) {
    li { flex-wrap: wrap; row-gap: 0.15rem; }
    time { flex-basis: 100%; }
  }
</style>
