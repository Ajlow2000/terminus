---
import WasmLoading from './WasmLoading.astro';

interface Props {
  // Path or URL to the wasm-bindgen JS glue file.
  // For local dev: a same-origin path like /wasm/my-demo/test-client.js
  // For production: a full URL (typically passed in by WasmRemote)
  src: string;
  // Optional name used for element IDs. Defaults to the second-to-last path
  // segment of src (e.g. "my-demo" from ".../wasm/my-demo/test-client.js").
  name?: string;
}

const { src } = Astro.props;
const name = Astro.props.name ?? src.split('/').at(-2) ?? 'wasm';
---

<div class="wasm-embed" id={`wasm-embed-${name}`}>
  <WasmLoading />
  <slot />
</div>

<script>
  // Reload the page when the theme changes so Bevy re-reads the CSS vars.
  // This script is only present when a wasm-embed is in the tree, so the
  // reload is scoped to pages that actually have a WASM app.
  new MutationObserver(() => window.location.reload()).observe(
    document.documentElement,
    { attributes: true, attributeFilter: ['data-theme'] },
  );
</script>

<script define:vars={{ src, name }}>
  (async () => {
    const container = document.getElementById(`wasm-embed-${name}`);
    const loading = container?.querySelector(".wasm-loading");

    try {
      // Snapshot canvases that exist before Bevy runs.
      const before = new Set(document.querySelectorAll("canvas"));

      const { default: init } = await import(src);
      // No argument needed — wasm-bindgen resolves the .wasm path relative to
      // import.meta.url, so it follows src whether that's a local path or a
      // remote URL.
      await init();

      // Poll until Bevy appends its canvas to the document.
      const canvas = await new Promise((resolve) => {
        const check = () => {
          const found = [...document.querySelectorAll("canvas")].find(c => !before.has(c));
          if (found) return resolve(found);
          requestAnimationFrame(check);
        };
        check();
      });

      // Move the canvas into our container so it obeys our layout.
      container?.appendChild(canvas);
      loading?.remove();
    } catch (err) {
      console.error(`[WasmEmbed] Failed to load "${src}":`, err);
      if (container) container.innerHTML = `<p class="wasm-error">Failed to load demo.</p>`;
      container?.dispatchEvent(new CustomEvent('wasm:error', { bubbles: true }));
    }
  })();
</script>

<style>
  .wasm-embed {
    width: 100%;
    max-width: 720px;
    margin: 1.5em auto;
    aspect-ratio: 16 / 9;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  /*
   * :global() is required because the canvas is created by Bevy at runtime
   * and moved into the container via JS — it never receives Astro's scoped
   * data attribute, so a normal scoped rule would never match it.
   *
   * !important is required because Bevy/winit sets inline styles on the canvas
   * (e.g. style="width: 1920px; height: 1080px") to reflect its internal window
   * size. In the CSS cascade, !important in a stylesheet beats a non-important
   * inline style set by JavaScript, so this wins without fighting Bevy's JS.
   */
  :global(.wasm-embed canvas) {
    width: 100% !important;
    height: 100% !important;
    display: block;
    outline: none;
  }

  .wasm-error {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-family: var(--f-ui);
    font-size: 13px;
    color: var(--ink-4);
  }
</style>

<!--
  Fleetsim theme — must live on :root because the WASM app calls
  window.getComputedStyle(document.documentElement) at startup and only
  accepts #rrggbb hex strings (var() and oklch() are silently ignored).

  Values are hex-converted from the site's oklch design tokens so they
  stay visually in-sync with the site palette in both modes.

  Caveat: Bevy reads the theme once at startup, so toggling light/dark
  after the canvas is running requires a page reload to take effect.
-->
<style is:global>
  /* Dark theme (site default) — derived from --bg/--ink/--forest tokens */
  :root {
    --fleetsim-bg:            #18221a;
    --fleetsim-panel:         #202d22;
    --fleetsim-surface:       #28372b;
    --fleetsim-text:          #f0f8f1;
    --fleetsim-text-muted:    #9ba99d;
    --fleetsim-unit:          #82cb92;
    --fleetsim-unit-selected: #a8ebb5;
    --fleetsim-obstacle:      #79371e;
  }

  /* Light theme (papyrus) — derived from --bg/--ink/--forest light values */
  [data-theme="light"] {
    --fleetsim-bg:            #f6f0df;
    --fleetsim-panel:         #ede5cf;
    --fleetsim-surface:       #e3d9bd;
    --fleetsim-text:          #1f1a12;
    --fleetsim-text-muted:    #7e745b;
    --fleetsim-unit:          #295935;
    --fleetsim-unit-selected: #008a39;
    --fleetsim-obstacle:      #95402b;
  }
</style>
