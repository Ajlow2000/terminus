---
import { getEntry } from "astro:content";
import Nav from "./nav/Nav.astro";
import Footer from "./Footer.astro";
import ColorScheme from "./ColorScheme.astro";

interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const { title, description, ogType = "website" } = Astro.props;
const currentPath = Astro.url.pathname;

const [navEntry, siteEntry] = await Promise.all([
  getEntry("pages", "nav"),
  getEntry("pages", "site"),
]);
const navLinks = navEntry?.data.links ?? [];
const siteTitle = siteEntry?.data.siteTitle ?? "alec lowry";
const socialLinks = siteEntry?.data.socialLinks ?? [];
const copyright = siteEntry?.data.copyright ?? `© ${new Date().getFullYear()} Alec Lowry`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.jpg" type="image/jpeg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <script is:inline>
      (function() {
        var t = localStorage.getItem("alec-theme") || "dark";
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <div class="app">
      <Nav siteTitle={siteTitle} navLinks={navLinks} currentPath={currentPath} />
      <div class="main-content">
        <slot />
      </div>
      <Footer copyright={copyright} socialLinks={socialLinks} />
    </div>
  </body>
</html>

<ColorScheme />

<style is:global>
  :root {
    /* Typography — not scheme-specific */
    --f-display: "Newsreader", Georgia, serif;
    --f-body: "Newsreader", Georgia, serif;
    --f-ui: "Inter", system-ui, -apple-system, sans-serif;
    --f-mono: "JetBrains Mono", ui-monospace, monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    font-family: var(--f-body);
    background: var(--bg);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
    font-size: 17px;
    line-height: 1.6;
    transition: background 0.25s, color 0.25s;
  }

  a {
    color: var(--forest);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 0.15s;
  }
  a:hover {
    color: var(--forest-strong);
    text-decoration-thickness: 2px;
  }

  h1, h2, h3, h4 {
    font-family: var(--f-display);
    color: var(--ink);
    letter-spacing: -0.012em;
    line-height: 1.15;
    font-weight: 600;
  }

  ::selection { background: var(--forest-2); }

  .app { min-height: 100dvh; display: flex; flex-direction: column; }
  .main-content { flex: 1; display: flex; flex-direction: column; }
  .container { max-width: 720px; margin: 0 auto; padding: 0 24px; width: 100%; }
  .container-wide { max-width: 1296px; margin: 0 auto; padding: 0 32px; width: 100%; }

  .tag {
    display: inline-flex; align-items: center;
    font-family: var(--f-ui); font-size: 12px; font-weight: 500;
    padding: 3px 10px; border-radius: 999px;
    border: 1px solid var(--line); color: var(--ink-2);
    background: var(--bg); text-decoration: none;
    cursor: pointer; transition: all 0.15s; user-select: none;
  }
  .tag:hover { border-color: var(--forest); color: var(--forest); background: var(--forest-3); }
  .tag.active { border-color: var(--forest); background: var(--forest-2); color: var(--forest); }
  .tag-mono { font-family: var(--f-mono); font-size: 11px; }

  .eyebrow {
    font-family: var(--f-ui); font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--forest);
  }
  .muted { color: var(--ink-3); }
  .small { font-size: 13px; }
  .mono { font-family: var(--f-mono); font-size: 12px; color: var(--ink-3); white-space: nowrap; }

  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 16px; border-radius: 6px;
    font-family: var(--f-ui); font-size: 14px; font-weight: 500;
    text-decoration: none; cursor: pointer; border: 1px solid transparent;
    transition: all 0.15s; white-space: nowrap;
  }
  .btn-primary { background: var(--forest); color: var(--bg); border-color: var(--forest); }
  .btn-primary:hover { background: var(--forest-strong); color: var(--bg); }
  .btn-ghost { background: transparent; color: var(--ink-2); border-color: var(--line); }
  .btn-ghost:hover { color: var(--forest); border-color: var(--forest); }

</style>
