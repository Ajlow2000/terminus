---
import * as cheerio from "cheerio";
import { codeToHtml } from "shiki";
import { SYNTAX_THEMES } from "../config";

const rawHtml = await Astro.slots.render("default");
const $ = cheerio.load(rawHtml);

const blocks = $("pre > code[class]");
const jobs: Promise<void>[] = [];

for (const el of blocks.toArray()) {
  const $code = $(el);
  const lang = ($code.attr("class") ?? "").replace(/^language-/, "");
  if (!lang) continue;

  const code = $code.text();
  jobs.push(
    codeToHtml(code, {
      lang,
      themes: SYNTAX_THEMES,
    })
      .then((highlighted) => {
        $code.closest("pre").replaceWith(highlighted);
      })
      .catch(() => {
        // unsupported language — leave block as-is
      })
  );
}

await Promise.all(jobs);

// Inject id attributes on headings that lack them (Typst output has none).
$("h1, h2, h3, h4, h5, h6").each((_, el) => {
  const $el = $(el);
  if (!$el.attr("id")) {
    const text = $el.text().trim();
    const slug = text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    $el.attr("id", slug);
  }
});

const processed = $("body").html() ?? rawHtml;
---

<Fragment set:html={processed} />
