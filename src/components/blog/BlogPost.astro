---
import BaseLayout from "../BaseLayout.astro";
import TableOfContents from "./TableOfContents.astro";
import PostHeader from "./PostHeader.astro";
import CodeBlock from "./CodeBlock.astro";
import { postSlug } from "../../utils/format";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  date: Date;
  description?: string;
  post?: any;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, date, description, post, headings = [] } = Astro.props;

const seriesName = post?.data?.series?.name;
const currentPart = post?.data?.series?.part;

// Get series prev/next
let prevPostSlug: string | undefined;
let nextPostSlug: string | undefined;
let seriesTotal = 0;
if (seriesName) {
  const allPosts = await getCollection("writing", ({ data }) => import.meta.env.PROD ? !data.draft : true);
  const inSeries = allPosts
    .filter((p) => p.data.series?.name === seriesName)
    .sort((a, b) => a.data.series!.part - b.data.series!.part);
  seriesTotal = inSeries.length;
  const idx = inSeries.findIndex((p) => p.id === post?.id);
  if (idx > 0) prevPostSlug = postSlug(inSeries[idx - 1].id);
  if (idx >= 0 && idx < inSeries.length - 1) nextPostSlug = postSlug(inSeries[idx + 1].id);
}

const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout title={`${title} — Alec Lowry`} description={description} ogType="article">
  <div class:list={["post-layout", { "no-toc": !hasToc }]}>
    {hasToc && (
      <TableOfContents
        headings={headings}
        seriesName={seriesName}
        currentPart={currentPart}
        seriesTotal={seriesTotal}
        prevPostSlug={prevPostSlug}
        nextPostSlug={nextPostSlug}
      />
    )}

    <article class="post-article">
      <PostHeader
        title={title}
        date={date}
        tags={post?.data?.tags}
        seriesName={seriesName}
        currentPart={currentPart}
      />
      <div class="post-body">
        <slot />
      </div>
    </article>
  </div>
  <CodeBlock />
</BaseLayout>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 720px);
    justify-content: center;
    gap: 56px;
    padding: 48px 32px 0;
    margin: 0 auto;
  }
  /* 3-column layout only when the viewport is wide enough that the TOC
     can appear alongside the full-width content column without shrinking it */
  @media (min-width: 1296px) {
    .post-layout:not(.no-toc) {
      grid-template-columns: 200px minmax(0, 720px) 200px;
      justify-content: initial;
      max-width: 1296px;
    }
  }
  .post-article { min-width: 0; }
  @media (max-width: 880px) {
    .post-layout { gap: 24px; padding: 32px 24px 0; }
    .post-article { max-width: 720px; margin: 0 auto; width: 100%; }
  }
  @media (max-width: 480px) {
    .post-layout { padding: 24px 18px 0; }
  }

  /* Post body */
  .post-body {
    font-family: var(--f-body); font-size: 18px;
    line-height: 1.7; color: var(--ink); min-width: 0;
  }
  @media (max-width: 480px) {
    .post-body { font-size: 17px; }
    .post-body :global(h2) { font-size: 24px; }
    .post-body :global(h3) { font-size: 20px; }
  }
  .post-body :global(> *) { margin: 0 0 1.4em; }
  .post-body :global(h2) {
    font-size: 30px; margin: 1.8em 0 0.6em; scroll-margin-top: 80px;
  }
  .post-body :global(h3) {
    font-size: 22px; margin: 1.6em 0 0.5em; scroll-margin-top: 80px;
  }
  .post-body :global(p) { color: var(--ink-2); }
  .post-body :global(strong) { color: var(--ink); font-weight: 600; }
  .post-body :global(em) { font-style: italic; }
  .post-body :global(code:not(pre code)) {
    font-family: var(--f-mono); font-size: 0.86em;
    background: var(--bg-3); padding: 1px 6px; border-radius: 4px; color: var(--ink);
  }
  .post-body :global(blockquote) {
    margin: 1.5em 0; padding: 0 0 0 24px;
    border-left: 3px solid var(--forest); color: var(--ink-2); font-style: italic;
  }
  .post-body :global(sup a) {
    text-decoration: none; font-family: var(--f-ui);
    font-size: 0.7em; vertical-align: super; padding: 0 2px;
  }
  .post-body :global(ol), .post-body :global(ul) {
    color: var(--ink-2); padding-left: 1.5em;
  }
  .post-body :global(li) { margin-bottom: 0.3em; }
  .post-body :global(img) { width: 100%; height: auto; display: block; }

  /* Tables */
  .post-body :global(table) {
    border-collapse: collapse; overflow-x: auto;
    width: max-content; max-width: 100%; margin: 1.5rem auto; font-size: 0.9rem;
  }
  .post-body :global(th) {
    text-align: left; padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--line); color: var(--ink);
  }
  .post-body :global(td) {
    padding: 0.4rem 0.75rem; border-bottom: 1px solid var(--line-2);
  }

  .post-body :global(h2),
  .post-body :global(h3) { position: relative; }

  .post-body :global(.heading-anchor) {
    display: inline-flex; align-items: center;
    opacity: 0; margin-left: 8px;
    color: var(--ink-4); text-decoration: none;
    vertical-align: middle; transition: opacity 0.15s;
    font-family: var(--f-ui); font-weight: 400;
  }
  .post-body :global(h2:hover .heading-anchor),
  .post-body :global(h3:hover .heading-anchor) { opacity: 1; }
  .post-body :global(.heading-anchor:hover) { color: var(--forest); }
</style>

<script>
  document.querySelectorAll<HTMLHeadingElement>(".post-body h2, .post-body h3").forEach(h => {
    if (!h.id) return;
    const a = document.createElement("a");
    a.className = "heading-anchor";
    a.href = `#${h.id}`;
    a.setAttribute("aria-label", "Link to this section");
    a.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`;
    h.appendChild(a);
  });
</script>
