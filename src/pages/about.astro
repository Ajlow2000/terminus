---
import Layout from "../layouts/Layout.astro";
import ExperienceContent from "../content/experience.typ";
---

<Layout title="About — Alec Lowry">
  <div class="container about-page">
    <article class="experience">
      <ExperienceContent />
    </article>
  </div>
</Layout>

<style>
  .about-page { padding: 56px 0 80px; }
  .experience {
    font-size: 17px;
  }

  .experience :global(h1) {
    font-family: var(--f-ui);
    font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--forest);
    margin: 2.5rem 0 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.4rem;
  }
  .experience :global(h1:first-child) { margin-top: 0; }

  .experience :global(.entry) { margin-bottom: 1.5rem; }
  .experience :global(.entry-header) {
    display: flex; justify-content: space-between;
    align-items: baseline; gap: 1rem;
  }
  .experience :global(.entry-title) { font-weight: 700; color: var(--ink); }
  .experience :global(.entry-title a) { color: var(--ink); text-decoration: none; }
  .experience :global(.entry-title a:hover) { color: var(--forest); text-decoration: underline; }
  .experience :global(.entry-date) {
    color: var(--ink-3); font-size: 0.8rem;
    white-space: nowrap; flex-shrink: 0;
  }
  .experience :global(.entry-meta) { color: var(--ink-3); font-size: 0.8rem; margin: 0.2rem 0 0.5rem; }
  .experience :global(.entry-courses) { color: var(--ink-3); font-size: 0.8rem; margin-top: 0.4rem; }

  .experience :global(ul) { margin: 0.4rem 0 0; padding-left: 1.4rem; color: var(--ink-2); }
  .experience :global(li) { margin-bottom: 0.25rem; line-height: 1.5; }

  .experience :global(.skills) { margin: 0; padding: 0; }
  .experience :global(.skill-row) { display: flex; gap: 0.75rem; margin-bottom: 0.4rem; align-items: baseline; }
  .experience :global(.skill-row dt) { color: var(--ink-3); font-size: 0.8rem; min-width: 6rem; flex-shrink: 0; }
  .experience :global(.skill-row dd) { margin: 0; color: var(--ink-2); }
</style>
