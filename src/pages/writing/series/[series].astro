---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PostList from "../../../components/PostList.astro";
import { toSlug } from "../../../utils/format";

export async function getStaticPaths() {
  const posts = await getCollection("writing", ({ data }) => import.meta.env.PROD ? !data.draft : true);
  const seriesMap = new Map<string, string>();
  posts.forEach((post) => {
    if (post.data.series) {
      const slug = toSlug(post.data.series.name);
      seriesMap.set(slug, post.data.series.name);
    }
  });
  return Array.from(seriesMap.entries()).map(([slug, name]) => ({
    params: { series: slug },
    props: { name },
  }));
}

const { name } = Astro.props;
const posts = (await getCollection("writing", ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .filter((p) => p.data.series?.name === name)
  .sort((a, b) => a.data.series!.part - b.data.series!.part);
---

<Layout title={`${name} — Alec Lowry`}>
  <div class="container series-detail-page">
    <span class="eyebrow">Series</span>
    <h1>{name}</h1>
    <PostList posts={posts} numbered />
  </div>
</Layout>

<style>
  .series-detail-page { padding: 56px 0 80px; }
  .series-detail-page h1 { font-size: 36px; margin: 12px 0 32px; }
</style>
