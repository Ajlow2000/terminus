---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PostList from "../../../components/PostList.astro";
import { formatDate, toSlug } from "../../../utils/format";

const posts = await getCollection("writing", ({ data }) => import.meta.env.PROD ? !data.draft : true);
const seriesMap = new Map<string, typeof posts>();

posts.forEach((post) => {
  if (post.data.series) {
    const name = post.data.series.name;
    if (!seriesMap.has(name)) seriesMap.set(name, []);
    seriesMap.get(name)!.push(post);
  }
});

const series = Array.from(seriesMap.entries())
  .sort((a, b) => a[0].localeCompare(b[0]))
  .map(([name, posts]) => ({
    name,
    slug: toSlug(name),
    posts: posts.sort((a, b) => a.data.series!.part - b.data.series!.part),
  }));
---

<Layout title="Series — Alec Lowry">
  <div class="container series-page">
    <span class="eyebrow">Browse by</span>
    <h1>Series</h1>
    {series.map(({ name, slug, posts }) => (
      <section>
        <h2><a href={`/writing/series/${slug}`}>{name}</a></h2>
        <PostList posts={posts} numbered />
      </section>
    ))}
  </div>
</Layout>

<style>
  .series-page { padding: 56px 0 80px; }
  .series-page h1 { font-size: 36px; margin: 12px 0 32px; }

  section { margin-bottom: 2.5rem; }
  h2 {
    font-size: 20px; margin: 0 0 0.75rem;
    padding-bottom: 0.5rem; border-bottom: 1px solid var(--line);
  }
  h2 a { color: var(--ink); text-decoration: none; }
  h2 a:hover { color: var(--forest); }
</style>
