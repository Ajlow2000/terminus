---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate, toSlug } from "../../utils/format";

const posts = (await getCollection("writing", ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagCounts = new Map<string, number>();
const seriesCounts = new Map<string, number>();

posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  });
  if (post.data.series) {
    const name = post.data.series.name;
    seriesCounts.set(name, (seriesCounts.get(name) ?? 0) + 1);
  }
});

const tags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
const series = Array.from(seriesCounts.entries()).sort((a, b) => a[0].localeCompare(b[0]));
---

<Layout title="Writing — Alec Lowry">
  <div class="container-wide">
    <div class="blog-layout">
      <aside class="blog-sidebar">
        <div class="section">
          <h4>Search</h4>
          <input class="search-input" id="search-input" placeholder="Filter posts..." />
        </div>

        <div class="section advanced-section">
          <h4 class="disclosure" id="advanced-toggle">
            <span>Advanced</span>
            <span class="chevron" id="advanced-chevron">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </span>
          </h4>
          <div class="advanced-body" id="advanced-body" style="display:none;">
            <div class="sub-section">
              <h4>Series</h4>
              <ul class="series-list">
                {series.map(([name, count]) => (
                  <li class="series-item" data-series={name}>
                    <span class="check">
                      <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    <span>{name}</span>
                    <span class="count">{count}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="sub-section">
              <h4>Tags</h4>
              <div class="tag-cloud">
                {tags.map(([tag]) => (
                  <button class="tag tag-mono" data-tag={tag} type="button">{tag}</button>
                ))}
              </div>
            </div>
          </div>
        </div>

        <button class="clear-filters" id="clear-filters" style="display:none;">Clear filters</button>
      </aside>

      <main>
        <div class="results-header">
          <h1>Writing</h1>
          <span class="count" id="post-count">{posts.length} posts</span>
        </div>

        <div class="post-list" id="post-list">
          {posts.map((p) => (
            <a class="post-list-item"
               href={`/writing/${p.id.replace(/\.[^.]+$/, "")}`}
               data-title={p.data.title.toLowerCase()}
               data-description={(p.data.description ?? "").toLowerCase()}
               data-tags={(p.data.tags ?? []).join(",")}
               data-series={p.data.series?.name ?? ""}>
              <div class="meta">
                <span class="mono">{formatDate(p.data.date)}</span>
                {p.data.series && (
                  <span class="eyebrow" style="font-size:10px">{p.data.series.name} &middot; part {p.data.series.part}</span>
                )}
              </div>
              <h3>{p.data.title}</h3>
              {p.data.description && <p>{p.data.description}</p>}
              {p.data.tags && p.data.tags.length > 0 && (
                <div class="tag-row">
                  {p.data.tags.map((t) => (
                    <span class="tag tag-mono">{t}</span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>

        <p class="no-results" id="no-results" style="display:none;">
          No posts match those filters. <button class="clear-filters" id="clear-filters-inline">Clear them</button>.
        </p>
      </main>
    </div>
  </div>
</Layout>

<style>
  .blog-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 56px;
    padding: 56px 0 24px;
  }
  @media (max-width: 900px) {
    .blog-layout { grid-template-columns: 1fr; gap: 16px; }
    .blog-sidebar { border-bottom: 1px solid var(--line); padding-bottom: 8px; }
    .blog-sidebar .section { margin-bottom: 16px; }
  }

  .blog-sidebar { font-family: var(--f-ui); }
  .blog-sidebar .section { margin-bottom: 28px; }
  .blog-sidebar h4 {
    font-family: var(--f-ui); font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ink-3); margin: 0 0 12px;
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
  }
  .blog-sidebar h4.disclosure {
    cursor: pointer; user-select: none; padding: 4px 0; transition: color 0.15s;
  }
  .blog-sidebar h4.disclosure:hover { color: var(--ink); }
  .blog-sidebar h4 .chevron {
    display: inline-flex; transition: transform 0.18s; color: var(--ink-3);
  }
  .blog-sidebar h4 .chevron.open { transform: rotate(180deg); }

  .advanced-section .sub-section { margin-bottom: 24px; }
  .advanced-section .sub-section:last-child { margin-bottom: 0; }
  .advanced-section .sub-section h4 {
    font-family: var(--f-ui); font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--ink-3); margin: 0 0 12px;
  }
  @media (max-width: 900px) {
    .advanced-section .advanced-body { padding-top: 12px; }
  }
  @media (min-width: 901px) {
    .blog-sidebar h4.disclosure { display: none; }
    .advanced-body { display: flex !important; flex-direction: column; gap: 24px; }
  }

  .search-input {
    width: 100%;
    background: var(--bg-2); border: 1px solid var(--line); color: var(--ink);
    padding: 7px 12px; border-radius: 6px;
    font-family: var(--f-ui); font-size: 13px;
    outline: none; transition: border-color 0.15s;
  }
  .search-input::placeholder { color: var(--ink-4); }
  .search-input:focus { border-color: var(--forest); }

  .series-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .series-item {
    display: flex; align-items: center; gap: 10px;
    font-size: 14px; cursor: pointer; padding: 4px 0; color: var(--ink-2);
    user-select: none; white-space: nowrap;
  }
  .series-item:hover { color: var(--forest); }
  .series-item .check {
    width: 14px; height: 14px; border-radius: 3px;
    border: 1.5px solid var(--line);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: all 0.15s;
  }
  .series-item .check svg { display: none; }
  .series-item.on .check { background: var(--forest); border-color: var(--forest); }
  .series-item.on .check svg { display: block; color: var(--bg); }
  .series-item .count { margin-left: auto; font-family: var(--f-mono); font-size: 11px; color: var(--ink-4); }
  .series-item.on { color: var(--forest); }

  .tag-cloud { display: flex; flex-wrap: wrap; gap: 6px; }

  .clear-filters {
    background: none; border: none; padding: 0;
    color: var(--ink-3); font-family: var(--f-ui); font-size: 12px;
    cursor: pointer; text-decoration: underline; text-underline-offset: 2px;
  }
  .clear-filters:hover { color: var(--forest); }

  .post-list { display: flex; flex-direction: column; gap: 36px; }
  .post-list-item {
    display: block; text-decoration: none; color: inherit;
    padding-bottom: 32px; border-bottom: 1px solid var(--line-2);
  }
  .post-list-item:last-child { border-bottom: none; padding-bottom: 0; }
  .post-list-item h3 { font-size: 26px; margin: 0 0 8px; transition: color 0.15s; }
  .post-list-item:hover h3 { color: var(--forest); }
  .post-list-item .meta {
    display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 10px;
  }
  .post-list-item p { margin: 0; color: var(--ink-2); font-size: 16px; }
  .post-list-item .tag-row { margin-top: 12px; display: flex; gap: 6px; flex-wrap: wrap; }
  .post-list-item .tag-row .tag { pointer-events: none; }

  .results-header {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--line);
  }
  .results-header h1 { font-size: 36px; margin: 0; }
  .results-header .count { font-family: var(--f-mono); font-size: 13px; color: var(--ink-3); }

  .no-results { color: var(--ink-3); padding: 32px 0; }
</style>

<script>
  const searchInput = document.getElementById("search-input") as HTMLInputElement;
  const postList = document.getElementById("post-list")!;
  const postItems = postList.querySelectorAll<HTMLElement>(".post-list-item");
  const countEl = document.getElementById("post-count")!;
  const clearBtn = document.getElementById("clear-filters")!;
  const clearInline = document.getElementById("clear-filters-inline")!;
  const noResults = document.getElementById("no-results")!;
  const advancedToggle = document.getElementById("advanced-toggle")!;
  const advancedBody = document.getElementById("advanced-body")!;
  const advancedChevron = document.getElementById("advanced-chevron")!;

  const activeTags = new Set<string>();
  const activeSeries = new Set<string>();

  function filter() {
    const q = searchInput.value.toLowerCase();
    let visible = 0;

    postItems.forEach((item) => {
      const title = item.dataset.title ?? "";
      const desc = item.dataset.description ?? "";
      const tags = (item.dataset.tags ?? "").split(",").filter(Boolean);
      const series = item.dataset.series ?? "";

      let show = true;
      if (q && !title.includes(q) && !desc.includes(q)) show = false;
      if (activeTags.size > 0 && ![...activeTags].every(t => tags.includes(t))) show = false;
      if (activeSeries.size > 0 && !activeSeries.has(series)) show = false;

      item.style.display = show ? "" : "none";
      if (show) visible++;
    });

    countEl.textContent = `${visible} ${visible === 1 ? "post" : "posts"}`;
    const hasFilters = activeTags.size > 0 || activeSeries.size > 0 || q.length > 0;
    clearBtn.style.display = hasFilters ? "" : "none";
    noResults.style.display = visible === 0 ? "" : "none";
    postList.style.display = visible === 0 ? "none" : "";
  }

  function clearAll() {
    searchInput.value = "";
    activeTags.clear();
    activeSeries.clear();
    document.querySelectorAll(".tag.active").forEach(el => el.classList.remove("active"));
    document.querySelectorAll(".series-item.on").forEach(el => el.classList.remove("on"));
    filter();
  }

  searchInput.addEventListener("input", filter);
  clearBtn.addEventListener("click", clearAll);
  clearInline.addEventListener("click", clearAll);

  // Tag filtering
  document.querySelectorAll<HTMLElement>(".tag-cloud .tag").forEach((btn) => {
    btn.addEventListener("click", () => {
      const tag = btn.dataset.tag!;
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        btn.classList.remove("active");
      } else {
        activeTags.add(tag);
        btn.classList.add("active");
      }
      filter();
    });
  });

  // Series filtering
  document.querySelectorAll<HTMLElement>(".series-item").forEach((item) => {
    item.addEventListener("click", () => {
      const name = item.dataset.series!;
      if (activeSeries.has(name)) {
        activeSeries.delete(name);
        item.classList.remove("on");
      } else {
        activeSeries.add(name);
        item.classList.add("on");
      }
      filter();
    });
  });

  // Advanced toggle (mobile)
  advancedToggle.addEventListener("click", () => {
    const open = advancedBody.style.display === "none";
    advancedBody.style.display = open ? "" : "none";
    advancedChevron.classList.toggle("open", open);
  });

  // Check for URL query params
  const params = new URLSearchParams(window.location.search);
  const initTag = params.get("tag");
  const initSeries = params.get("series");
  if (initTag) {
    activeTags.add(initTag);
    document.querySelector(`.tag[data-tag="${initTag}"]`)?.classList.add("active");
    advancedBody.style.display = "";
    advancedChevron.classList.add("open");
    filter();
  }
  if (initSeries) {
    activeSeries.add(initSeries);
    document.querySelector(`.series-item[data-series="${initSeries}"]`)?.classList.add("on");
    advancedBody.style.display = "";
    advancedChevron.classList.add("open");
    filter();
  }
</script>
