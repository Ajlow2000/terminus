---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";

const posts = await getCollection("writing", ({ data }) => import.meta.env.PROD ? !data.draft : true);
const tagCounts = new Map<string, number>();
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  });
});
const tags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<Layout title="Tags — Alec Lowry">
  <div class="container tags-page">
    <span class="eyebrow">Browse by</span>
    <h1>Tags</h1>
    <div class="tag-list">
      {tags.map(([tag, count]) => (
        <a class="tag-item" href={`/writing/tags/${tag}`}>
          <span class="name">#{tag}</span>
          <span class="count">{count}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  .tags-page { padding: 56px 0 80px; }
  .tags-page h1 { font-size: 36px; margin: 12px 0 32px; }

  .tag-list { display: flex; flex-direction: column; gap: 0; }
  .tag-item {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 12px 0; border-bottom: 1px solid var(--line-2);
    text-decoration: none; color: var(--ink); transition: color 0.15s;
  }
  .tag-item:hover { color: var(--forest); }
  .tag-item:hover .name { text-decoration: underline; }
  .name { font-family: var(--f-mono); font-size: 15px; }
  .count { font-family: var(--f-mono); font-size: 12px; color: var(--ink-3); }
</style>
