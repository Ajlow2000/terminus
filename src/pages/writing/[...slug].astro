---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import SyntaxHighlightedContent from "../../components/SyntaxHighlightedContent.astro";

export async function getStaticPaths() {
  const posts = await getCollection("writing", ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.[^.]+$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost title={post.data.title} date={post.data.date} description={post.data.description} post={post} headings={headings}>
  <SyntaxHighlightedContent>
    <Content />
  </SyntaxHighlightedContent>
</BlogPost>
