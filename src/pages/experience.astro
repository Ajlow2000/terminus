---
import ExperienceContent from '../content/experience.typ';
import Layout from '../layouts/Layout.astro';
---
<Layout title="Experience — Alec Lowry">
  <div class="container experience-page">
    <span class="eyebrow">Experience</span>
    <h1>Work &amp; Education</h1>
    <article>
      <ExperienceContent />
    </article>
  </div>
</Layout>

<style>
  .experience-page { padding: 56px 0 80px; }
  .experience-page h1 {
    font-size: 36px; margin: 12px 0 32px;
    letter-spacing: -0.02em;
  }

  article { font-size: 17px; }

  article :global(h1) {
    font-family: var(--f-ui);
    font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--forest);
    margin: 2.5rem 0 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.4rem;
  }
  article :global(h1:first-child) { margin-top: 0; }

  article :global(.entry) { margin-bottom: 1.5rem; }
  article :global(.entry-header) {
    display: flex; justify-content: space-between;
    align-items: baseline; gap: 1rem;
  }
  article :global(.entry-title) { font-weight: 700; color: var(--ink); }
  article :global(.entry-title a) { color: var(--ink); text-decoration: none; }
  article :global(.entry-title a:hover) { color: var(--forest); text-decoration: underline; }
  article :global(.entry-date) {
    color: var(--ink-3); font-size: 0.8rem;
    white-space: nowrap; flex-shrink: 0;
  }
  article :global(.entry-meta) { color: var(--ink-3); font-size: 0.8rem; margin: 0.2rem 0 0.5rem; }
  article :global(.entry-courses) { color: var(--ink-3); font-size: 0.8rem; margin-top: 0.4rem; }

  article :global(ul) { margin: 0.4rem 0 0; padding-left: 1.4rem; color: var(--ink-2); }
  article :global(li) { margin-bottom: 0.25rem; line-height: 1.5; }

  article :global(.skills) { margin: 0; padding: 0; }
  article :global(.skill-row) { display: flex; gap: 0.75rem; margin-bottom: 0.4rem; align-items: baseline; }
  article :global(.skill-row dt) { color: var(--ink-3); font-size: 0.8rem; min-width: 6rem; flex-shrink: 0; }
  article :global(.skill-row dd) { margin: 0; color: var(--ink-2); }
</style>
