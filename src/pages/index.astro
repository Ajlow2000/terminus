---
import BaseLayout from "../components/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const homeEntry = await getEntry("pages", "home");
const { Content: Bio } = await render(homeEntry!);
---

<BaseLayout title="Alec Lowry's Website">
  <div class="landing">
    <div class="landing-inner">
      <!-- TODO: add headshot image -->
      <!-- <div class="landing-portrait" /> -->
      <!-- <span class="eyebrow landing-eyebrow">Writer &middot; Engineer &middot; Paddler</span> -->
      <h1 class="landing-name">Alec Lowry</h1>
      <div class="landing-bio"><Bio /></div>
    </div>
  </div>
</BaseLayout>

<style>
  .landing {
    flex: 1;
    display: flex; align-items: center; justify-content: center;
    padding: 24px 80px;
    min-height: 0;
  }
  .landing-inner {
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
    max-width: 640px;
  }
  .landing-eyebrow {
    margin-bottom: 14px;
    letter-spacing: 0.18em !important;
  }
  .landing-name {
    font-family: var(--f-display); font-weight: 600;
    font-size: clamp(44px, 7vw, 64px);
    line-height: 1; letter-spacing: -0.025em;
    margin: 0 0 28px;
    color: var(--ink);
  }
  .landing-bio {
    font-size: 19px; color: var(--ink-2);
    line-height: 1.65; margin: 0;
    font-style: italic;
    max-width: 56ch;
  }
  /* Reset margins on the rendered <p> */
  .landing-bio :global(p) { margin: 0; color: inherit; }
  .landing-bio :global(em) { font-style: normal; color: var(--ink); }
  .landing-bio :global(a) { color: inherit; }
  .landing-bio :global(a):hover { color: var(--forest); }

  @media (max-width: 600px) {
    .landing { padding: 24px; }
    .landing-bio { font-size: 17px; }
  }
</style>
