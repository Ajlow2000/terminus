---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Alec Lowry — writer, engineer, paddler">
  <div class="landing">
    <div class="landing-inner">
      <!-- TODO: add headshot image -->
      <!-- <div class="landing-portrait" /> -->
      <span class="eyebrow landing-eyebrow">Writer &middot; Engineer &middot; Paddler</span>
      <h1 class="landing-name">Alec Lowry</h1>
      <p class="landing-bio">
        I'm a software engineer working in cybersecurity and Linux. I write here about <em>programming</em>, <em>whitewater rescue</em>, books I'm chewing on, and whatever else I'm trying to think clearly about.
      </p>
    </div>
  </div>
</Layout>

<style>
  .landing {
    flex: 1;
    display: flex; align-items: center; justify-content: center;
    padding: 24px 80px;
    min-height: 0;
  }
  .landing-inner {
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
    max-width: 640px;
  }
  .landing-portrait {
    width: 96px; height: 96px;
    border-radius: 50%;
    margin-bottom: 32px;
    background:
      radial-gradient(ellipse at 35% 30%,
        oklch(0.65 0.05 150) 0%,
        oklch(0.50 0.07 150) 28%,
        oklch(0.32 0.06 150) 55%,
        oklch(0.20 0.04 150) 100%);
    position: relative;
    overflow: hidden;
  }
  .landing-portrait::before {
    content: "";
    position: absolute;
    bottom: -8%; left: 50%;
    width: 78%; height: 80%;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse 22% 28% at 50% 22%, oklch(0.78 0.04 60) 0%, oklch(0.62 0.06 50) 50%, transparent 80%),
      radial-gradient(ellipse 60% 50% at 50% 95%, oklch(0.18 0.02 150) 0%, oklch(0.18 0.02 150) 35%, transparent 70%);
  }
  :global([data-theme="dark"]) .landing-portrait::before {
    background:
      radial-gradient(ellipse 22% 28% at 50% 22%, oklch(0.72 0.05 60) 0%, oklch(0.55 0.07 50) 50%, transparent 80%),
      radial-gradient(ellipse 60% 50% at 50% 95%, oklch(0.10 0.02 150) 0%, oklch(0.10 0.02 150) 35%, transparent 70%);
  }
  .landing-eyebrow {
    margin-bottom: 14px;
    letter-spacing: 0.18em !important;
  }
  .landing-name {
    font-family: var(--f-display); font-weight: 600;
    font-size: clamp(44px, 7vw, 64px);
    line-height: 1; letter-spacing: -0.025em;
    margin: 0 0 28px;
    color: var(--ink);
  }
  .landing-bio {
    font-size: 19px; color: var(--ink-2);
    line-height: 1.65; margin: 0;
    font-style: italic;
    max-width: 56ch;
  }
  .landing-bio em { font-style: normal; color: var(--ink); }

  @media (max-width: 600px) {
    .landing { padding: 24px; }
    .landing-bio { font-size: 17px; }
  }
</style>
